  "kb": [
    {
      "id": "k1",
      "title": "密码过期与重置",
      "body": "密码有效期 90 天，过期后可在自助门户重置，重置后需 5 分钟内修改临时密码。"
    },
    {
      "id": "k2",
      "title": "账号锁定规则",
      "body": "连续 5 次密码错误锁定 30 分钟，也可由服务台手工解锁。"
    },
    {
      "id": "k3",
      "title": "VPN 连接失败排查",
      "body": "先确认客户端版本，再检查本地网络与证书有效期，最后检查账号是否被禁用。"
    },
    {
      "id": "k4",
      "title": "资产申领流程",
      "body": "申领需先确认库存，由服务台分配并登记资产编号，资产不可逆转移需本人签收。"
    },
    {
      "id": "k5",
      "title": "邮件客户端配置",
      "body": "使用 IMAP 993 与 SMTP 465 加密端口，账号为域账号全称。"
    },
    {
      "id": "k6",
      "title": "打印机离线处理",
      "body": "检查队列是否卡死、驱动是否为最新版本，必要时重启打印服务。"
    },
    {
      "id": "k7",
      "title": "权限申请",
      "body": "系统权限需上级审批，服务台仅受理已审批单据。"
    },
    {
      "id": "k8",
      "title": "会议设备故障",
      "body": "先检查 HDMI 与供电，再检查投屏码是否过期。"
    }
  ]
